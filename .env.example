OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_COPILOT_MODEL=gpt-4o
OPENAI_WORKER_MODEL=gpt-4o-mini

FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
FOUNDRY_RESPONSES_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>/applications/<app>/protocols/openai/responses?api-version=2025-11-15-preview
FOUNDRY_ACTIVITY_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>/applications/<app>/protocols/activityprotocol?api-version=2025-11-15-preview
FOUNDRY_ACCOUNT_NAME=<account-resource-name>
FOUNDRY_PROJECT_NAME=<project-name>
FOUNDRY_APPLICATION_NAME=FNSS
FOUNDRY_AGENT_DEPLOYMENT_NAME=FNSS
FOUNDRY_AGENT_DEPLOYMENT_TYPE=Managed
FOUNDRY_AGENT_MODEL=deepseek-V3.1
FOUNDRY_WORKFLOW_AGENT_NAME=FNSS-Workflow
FOUNDRY_MANAGEMENT_API_VERSION=2025-10-01-preview
AZURE_OPENAI_DEPLOYMENT=deepseek-V3.1
AZURE_SUBSCRIPTION_ID=<subscription-id>
AZURE_RESOURCE_GROUP=<resource-group>
AZURE_CONFIG_DIR=.azure-cli
AZURE_CLI_PATH=C:\Program Files\Microsoft SDKs\Azure\CLI2\wbin\az.cmd
